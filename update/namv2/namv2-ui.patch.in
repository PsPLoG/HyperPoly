diff --git a/ingen_wrapper.py b/ingen_wrapper.py
--- a/ingen_wrapper.py
+++ b/ingen_wrapper.py
@@ -270,6 +270,21 @@ def set_json_nam(effect_id, file_name):
     q.put((ingen.set, effect_id, "http://polyeffects.com/lv2/polyconvo#ir", "<"+file_name+">")) # for UI persist
 
 
+def set_json_namv2(effect_id, file_name):
+    file_name = urllib.parse.quote(file_name)
+    # Persist paths below /audio so presets remain portable across mounts.
+    n = file_name.find("/audio")
+    if n < 0:
+        raise ValueError("NAMv2 model path must be below /audio: " + file_name)
+    file_name = file_name[n:]
+    body = """[
+         a patch:Set ;
+         patch:property <@NAMV2_MODEL_PROPERTY_URI@>;
+         patch:value <file://"""+ file_name + "> ]"
+    q.put((ingen.set, effect_id+"/@NAMV2_PATCH_PORT_SYMBOL@", "http://drobilla.net/ns/ingen#activity", body))
+    q.put((ingen.set, effect_id, "http://polyeffects.com/lv2/polyconvo#ir", "<"+file_name+">"))
+
+
 def set_file(effect_id, file_name, is_cab, effect_type):
     effect_id = effect_id
     file_name = urllib.parse.quote(file_name[len("file://"):])
