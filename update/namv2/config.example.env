# Copy this file to config.env and replace every REQUIRED value after running:
#   python3 inspect-deb.py /path/to/namv2.deb --extract-to work/extracted

# Must be different from the existing NAM URI:
# http://github.com/mikeoliphant/neural-amp-modeler-lv2
NAMV2_PLUGIN_URI="REQUIRED"

# patch:Set property used to load a NAMv2 model file.
# Inspect patch:writable / atom:Path declarations in the NAMv2 TTL.
NAMV2_MODEL_PROPERTY_URI="REQUIRED"

# Atom input port that receives patch:Set messages. Usually "control".
NAMV2_PATCH_PORT_SYMBOL="control"

# LV2 port symbols from the NAMv2 TTL.
NAMV2_AUDIO_INPUT_SYMBOL="input"
NAMV2_AUDIO_OUTPUT_SYMBOL="output"
NAMV2_INPUT_LEVEL_SYMBOL="input_level"
NAMV2_OUTPUT_LEVEL_SYMBOL="output_level"

# UI ranges. Change these only when the NAMv2 TTL uses different ranges.
NAMV2_INPUT_LEVEL_DEFAULT="-25.0"
NAMV2_INPUT_LEVEL_MIN="-45.0"
NAMV2_INPUT_LEVEL_MAX="5.0"
NAMV2_OUTPUT_LEVEL_DEFAULT="0.0"
NAMV2_OUTPUT_LEVEL_MIN="-20.0"
NAMV2_OUTPUT_LEVEL_MAX="20.0"

# NAMv2 model files are isolated from classic NAM captures.
# NAMV2_MODEL_ROOT is the path stored in UI state and presets.
# NAMV2_MODEL_STORAGE_ROOT is the writable path on the data partition.
# Put NAMv2 files or archives in USB_ROOT/amps_v2 for the settings import button.
NAMV2_DEFAULT_MODEL="REQUIRED"
NAMV2_MODEL_ROOT="/audio/amp_namv2"
NAMV2_MODEL_STORAGE_ROOT="/mnt/audio/amp_namv2"
NAMV2_USB_MODEL_FOLDER="amps_v2"
