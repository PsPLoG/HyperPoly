diff --git a/amp_browser_model.py b/amp_browser_model.py
--- a/amp_browser_model.py
+++ b/amp_browser_model.py
@@ -18,15 +18,31 @@ current_search = ""
 # start_path = "/git_repos/capture_to_pedal"
 start_path = "/mnt/audio/amp_nam"
 amp_folders  = None #glob.glob(start_path+"/*/metadata.json", recursive=True)
 filtered_amps = None #amp_folders.copy()
 favourites = {}
 master_amp_metadata = {}
 
+def normalise_model_root(model_root):
+    model_root = str(model_root)
+    if model_root.startswith("file://"):
+        model_root = model_root[len("file://"):]
+    if model_root.startswith("/audio/"):
+        model_root = "/mnt" + model_root
+    model_root = os.path.normpath(model_root)
+    if not model_root.startswith("/mnt/audio/"):
+        raise ValueError("amp model root must be below /mnt/audio: " + model_root)
+    return model_root
+
 def combine_metadata():
+    global master_amp_metadata
+    global amp_folders
+    global filtered_amps
+
+    loaded_metadata = {}
     metadatas = glob.glob(start_path+"/*/metadata.json")
     for m in metadatas:
         a = json.load(open(m))
@@ -42,10 +58,9 @@ def combine_metadata():
             else:
                 # choose first
                 a["selected_controls"][control_name] = a["controls"][i][0]
 
-        master_amp_metadata[os.path.relpath(os.path.dirname(m), start_path)] = a
+        loaded_metadata[os.path.relpath(os.path.dirname(m), start_path)] = a
 
-    global amp_folders
-    global filtered_amps
+    master_amp_metadata = loaded_metadata
     amp_folders  = sorted(list(master_amp_metadata.keys()), key=lambda v: v.upper())
     filtered_amps = amp_folders.copy()
@@ -91,6 +106,22 @@ class AmpBrowserModel(QAbstractListModel):
     def external_update_reset(self):
         combine_metadata()
         self.clear_filter()
 
+    @Slot(str)
+    def set_model_root(self, model_root):
+        global start_path
+        global current_search
+
+        new_root = normalise_model_root(model_root)
+        if new_root == start_path:
+            self.external_update_reset()
+            return
+
+        self.beginResetModel()
+        start_path = new_root
+        current_search = ""
+        current_filters.clear()
+        combine_metadata()
+        self.__order = dict(enumerate(filtered_amps))
+        self.endResetModel()
+
     @Slot()
     def clear_filter(self):
         global current_search
         current_search = ""
