diff --git a/show_widget.py b/show_widget.py
--- a/show_widget.py
+++ b/show_widget.py
@@ -1164,6 +1164,24 @@ class Knobs(QObject):
 
         self.launch_subprocess(command, after=amp_browser_model_s.external_update_reset)
 
+    @Slot()
+    def ui_copy_amps_v2(self):
+        # NAMv2 model files are intentionally isolated from classic NAM.
+        # Copy every file type so a different NAMv2 model extension is not
+        # filtered out. Zip archives are expanded after copying.
+        command = """ sudo mount -o remount,rw /dev/mmcblk0p2 /mnt;
+        if [ -d /usb_flash/@NAMV2_USB_MODEL_FOLDER@ ]; then
+        mkdir -p @NAMV2_MODEL_STORAGE_ROOT@;
+        cp -a /usb_flash/@NAMV2_USB_MODEL_FOLDER@/. @NAMV2_MODEL_STORAGE_ROOT@/;
+        cd @NAMV2_MODEL_STORAGE_ROOT@;
+        find . -iname "*.zip" -type f -print0 | xargs -0 -r -n1 unzip -o;
+        find . -iname "*.zip" -type f -print0 | xargs -0 -r rm;
+        fi;
+        sudo mount -o remount,ro /dev/mmcblk0p2 /mnt;"""
+        command_status[0].value = -1
+
+        self.launch_subprocess(command, after=amp_browser_model_s.external_update_reset)
+
     @Slot(str, result=str)
     def ui_usb_folder_size(self, folder):
         # return how large a USB folder is in mb, will give us an approx idea of what will be copied
@@ -1180,6 +1198,7 @@ class Knobs(QObject):
         <p>Cabs: {self.ui_usb_folder_size("/usb_flash/cabs")} </p>
         <p>Reverbs: {self.ui_usb_folder_size("/usb_flash/reverbs")} </p>
         <p>Amps: {self.ui_usb_folder_size("/usb_flash/amps")} </p>
+        <p>NAMv2 amps: {self.ui_usb_folder_size("/usb_flash/@NAMV2_USB_MODEL_FOLDER@")} </p>
         <h3>Remaining user storage</h3>
         <p>{self.remaining_user_storage()}</p>
         """
